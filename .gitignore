## Arquivo gerado automaticamente: regras para ignorar artefatos locais, bytecode e IDE
# - Não commitar ambientes virtuais, arquivos SQLite locais, bytecode, ou config de IDE
db.sqlite3

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyc

# IDE/editor config
.vscode/
.idea/

# Virtual environments and test caches
.venv/
.pytest_cache/

# Local SQLite files
*.sqlite3
